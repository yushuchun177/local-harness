var lang: String = "zh"


func _ready() -> void:
	lang = str(App.cfg.get("lang", "zh")) if App else "zh"


func set_lang(v: String) -> void:
	lang = v if (v == "en" or v == "zh") else "zh"
	App.set_cfg("lang", lang)
	language_changed.emit(lang)


func t(key: String, force_lang := "") -> String:
	var table: Dictionary = EN if (force_lang if force_lang != "" else lang) == "en" else ZH
	return str(table.get(key, key))


func strings() -> Dictionary:
	return EN if lang == "en" else ZH
